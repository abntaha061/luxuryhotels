<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/floatingToggleRoot"
    android:layout_width="48dp"
    android:layout_height="48dp"
    android:background="@drawable/bg_floating_toggle"
    android:clickable="true"
    android:contentDescription="@string/app_name"
    android:elevation="14dp"
    android:focusable="true">

    <!-- Status indicator / icon -->
    <ImageView
        android:id="@+id/ivToggleIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@string/app_name"
        android:src="@drawable/ic_pause" />

    <!-- Tiny status dot at corner -->
    <View
        android:id="@+id/viewToggleStatusDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="5dp"
        android:layout_marginEnd="5dp"
        android:background="@drawable/bg_resize_handle" />

</FrameLayout>
