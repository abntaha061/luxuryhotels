<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Header Banner -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingVertical="12dp">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:contentDescription="@string/app_name"
                android:src="@drawable/ic_app_logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SubTranslate"
                    android:textColor="#F8FAFC"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Real-Time Dynamic Bubble Translator"
                    android:textColor="#94A3B8"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_control_widget"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="● Ready"
                android:textColor="#10B981"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Primary Action Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_subtitle_overlay"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Auto-Tracking Subtitle Translator"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="No manual cropping box required. Captures screen, detects English subtitle bounding box, and positions a floating Arabic bubble directly underneath."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnStartTranslator"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:backgroundTint="#00E5FF"
                android:text="Start Auto-Tracking Translator"
                android:textColor="#0B0F19"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnStopTranslator"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#DC2626"
                android:text="Stop Translator"
                android:textColor="#FFFFFF"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Live Subtitle Monitor Preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_subtitle_overlay"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Subtitle Monitor"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLiveEnglish"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#0F172A"
                android:padding="10dp"
                android:text="[Waiting for English text...]"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:textStyle="italic" />

            <TextView
                android:id="@+id/tvLiveArabic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="#0F172A"
                android:gravity="right"
                android:padding="10dp"
                android:text="[في انتظار الترجمة...]"
                android:textColor="#00E5FF"
                android:textSize="16sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Offline Translation Model Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_subtitle_overlay"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="On-Device ML Kit Translation Model"
                android:textColor="#F8FAFC"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvModelStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="English to Arabic offline model status: Checking..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />

            <ProgressBar
                android:id="@+id/pbModelDownload"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="8dp"
                android:indeterminate="true"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnDownloadModel"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#0284C7"
                android:text="Download Offline Model (~30MB)"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <!-- Permissions Checklist -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_subtitle_overlay"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Required Permissions"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnOverlayPermission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="10dp"
                android:backgroundTint="#1E293B"
                android:text="Grant Overlay (Display Over Other Apps)"
                android:textColor="#E2E8F0" />

            <Button
                android:id="@+id/btnNotificationPermission"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#1E293B"
                android:text="Grant Notification Permission"
                android:textColor="#E2E8F0" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
